# Python bytecode and caches
__pycache__/
*.py[codz]

# Virtual environments: .venv is the offline one, .venv-integration the one
# scripts/test_integration.sh builds and .venv-ha the one .devcontainer/develop.sh
# runs from, so Home Assistant never lands in .venv.
.venv
.venv-integration
.venv-ha

# The Home Assistant config directory .devcontainer/develop.sh runs against: its
# store, logs and the HACS checkout. Ruff reads this file (`respect-gitignore`),
# so listing it here is also what keeps HACS's sources out of `ruff check .`.
.ha-config/

# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Backend coverage output (scripts/ci_local.sh and CI ask pytest for it).
.coverage
.coverage.*
coverage.xml
htmlcov/

# HA_BASE_URL / HA_TOKEN for the helper scripts — a live instance's credentials.
.env
.envrc

# Python packaging output
build/
dist/
*.egg-info/

# Editor directories
.vscode/

# CI/test artifacts
junit.xml
integration-junit.xml

# OS-specific junk
.DS_Store
Thumbs.db

# Frontend build artifacts — the card is built into the integration package and
# shipped from there; the bundle itself is never committed.
custom_components/haventory/www/

# The HACS install bundle, built on a tag and attached to the release.
haventory.zip

# Node — the card has its own .gitignore, but tooling run from the repo root
# (npx, vitest) can drop a node_modules/ here too.
node_modules/

# Claude Code scratch checkouts. The rest of .claude/ is tracked on purpose —
# settings, hooks and skills are part of the repo — but worktrees are per-session
# working copies that would otherwise show as untracked in every session.
.claude/worktrees/
