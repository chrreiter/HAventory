{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "bump-minor-pre-major": true,
  "include-component-in-tag": false,
  "draft": true,
  "force-tag-creation": true,
  "packages": {
    ".": {
      "package-name": "haventory",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "custom_components/haventory/manifest.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "cards/haventory-card/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "cards/haventory-card/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "cards/haventory-card/package-lock.json",
          "jsonpath": "$.packages[\"\"].version"
        },
        {
          "type": "generic",
          "path": "custom_components/haventory/const.py"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='haventory')].version"
        }
      ]
    }
  }
}
