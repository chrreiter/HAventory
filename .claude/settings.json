{
  "permissions": {
    "allow": [
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(ruff --version)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(pip install -r requirements-dev.txt)",
      "Bash(pip install --quiet -r requirements-dev.txt)",
      "Bash(pre-commit run:*)",
      "Bash(npm ci)",
      "Bash(npm install:*)",
      "Bash(npm run build)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npx eslint:*)",
      "Bash(npx vitest run:*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git fetch:*)",
      "Bash(git stash list)",
      "Bash(git ls-files:*)"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
